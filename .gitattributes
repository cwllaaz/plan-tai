# 统一换行符：源码与脚本在仓库内一律 LF，避免 Linux 脚本因 CRLF 无法执行。
* text=auto eol=lf

# Windows 脚本保留 CRLF（PowerShell 5.1 / cmd 兼容性更好）
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本强制 LF
*.sh text eol=lf
*.desktop text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.otf binary
*.ttf binary
*.zip binary
*.apk binary
*.deb binary
*.jks binary
*.keystore binary
*.so binary
*.dll binary
*.exe binary
*.dat binary
